{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=localhost;Database=DrivingTest;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Database": {
    "AutoInitialize": false,
    "QuestionsSeedFile": "Seed/questions.sample.json",
    "ExpectedQuestionCount": 0
  },

  "Jwt": {
    "Issuer": "DrivingTest",
    "Audience": "DrivingTest.Web",
    "Key": "dev-only-secret-key-change-me-please-0123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "Exam": {
    "TotalQuestions": 35,
    "DurationMinutes": 19,
    "PassScore": 32,
    "MinCriticalQuestions": 1,
    "SubmitGraceSeconds": 15,
    "ExpirationSweepSeconds": 60,
    "ExpirationBatchSize": 100,
    "TopicQuota": {
      "rules": 9,
      "signs": 9,
      "scenarios": 10,
      "driving-skills": 3,
      "vehicle": 2,
      "ethics": 2
    }
  },

  "Cache": {
    "BankMinutes": 60,
    "HomeStatsMinutes": 5
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "RateLimiting": {
    "AuthPermitLimit": 10,
    "CheckPermitLimit": 120,
    "WindowSeconds": 60
  }
}
